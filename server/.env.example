# Copy to .env (git-ignored), fill in, and start with:  node --env-file=.env src/server.js
# Never commit .env. Never put any of these values in the browser extension.

NODE_ENV=production
PORT=8443
# The public address of the dashboard. Must be https:// in production.
BASE_URL=https://tracker.example.com
# Only this origin may call the API from a browser (the dashboard). Same value as BASE_URL.
CORS_ORIGIN=https://tracker.example.com

# --- secrets: generate each one yourself, keep them out of the database and out of git ---
COOKIE_SECRET=                 # openssl rand -hex 32          (>= 32 chars; signs the owner's session cookies)
MASTER_KEY=                    # openssl rand -base64 32       (32 bytes; encrypts every stored record. LOSE IT = DATA UNREADABLE.
                               #                                Store a copy somewhere other than the backups.)

# --- token lifetimes (seconds) ---
ACCESS_TTL=900                 # owner dashboard access cookie: 15 min
REFRESH_TTL=2592000            # owner dashboard refresh cookie: 30 days
DEVICE_ACCESS_TTL=900          # device access tokens: 15 min (the device's long-lived credential is never sent except to /api/device/token)

# --- storage and backups ---
DB_PATH=./data/tracker.db
BACKUP_DIR=./data/backups      # put this on a DIFFERENT disk or copy it off the machine (see docs/OPERATIONS.md)
BACKUP_KEEP=14                 # newest N backups are kept
BACKUP_INTERVAL_HOURS=24       # 0 disables scheduled backups (a backup is still taken at start-up if the newest is older than this)

# --- TLS: pick ONE ---
# (a) Recommended: a reverse proxy (Caddy/nginx) terminates TLS; this server listens on 127.0.0.1 only.
TRUST_PROXY=true
# (b) Or let this server hold the certificate itself:
# TLS_CERT=/etc/ssl/tracker.crt
# TLS_KEY=/etc/ssl/tracker.key

# --- optional ---
# ENROLL_RATE_MAX=20           # pairing attempts per IP per hour (leave the default; raise only for automated tests)
# PAIRING_CODE_TTL_MIN=15       # how long a pairing code stays valid (minutes)
# PAIRING_MAX_FAILS=5           # wrong codes from one address before a 15-minute lockout
