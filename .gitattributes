# Shell scripts, service units and nginx templates run on Linux: they must always be checked out with LF line endings,
# even on Windows, or bash fails with "\r: command not found".
*.sh        text eol=lf
*.tpl       text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
# Binary assets
*.png  binary
*.jpg  binary
*.zip  binary
*.mp4  binary
*.woff2 binary
